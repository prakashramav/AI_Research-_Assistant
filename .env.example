# AI Research Assistant Environment Variables

# Google Gemini API Key (get free at https://aistudio.google.com/)
GEMINI_API_KEY=

# Search API Key (Tavily, Serper, or Bing - leave blank for mock mode)
SEARCH_API_KEY=

# Search Provider: "tavily", "serper", or "bing"
SEARCH_PROVIDER=tavily

# Database URL (SQLite default, can be replaced with PostgreSQL)
DATABASE_URL=sqlite:///./research_assistant.db

# Vector Storage Directory
VECTOR_DB_PATH=./vector_store

# Set to true to force offline mock data without external API calls
MOCK_MODE=false

# Gemini Model name (gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash
